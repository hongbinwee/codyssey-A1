# AX Ground 환경 변수 예시 — 실제 값은 절대 커밋하지 않는다.
# 로컬: .env 파일 또는 셸 환경 변수로 설정 / 배포: Vercel 프로젝트 환경 변수에 등록

# AI 게이트웨이 인증 키 (필수)
AI_API_KEY=

# OpenAI 호환 chat completions 엔드포인트 (기본값: 교육기관 게이트웨이)
AI_API_BASE=https://copa.codyssey.kr/v1/chat/completions

# 사용 모델 (기본값: gpt-5.5)
AI_MODEL=gpt-5.5

# AI 요청 제한 시간(초) (기본값: 20)
AI_TIMEOUT=20

# 로컬 검증 전용: 1이면 실제 AI 호출 없이 mock 결과를 반환한다.
# 배포 환경에서는 절대 설정하지 않는다.
# AXG_MOCK_AI=1
